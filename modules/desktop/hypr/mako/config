# Keep notifications until dismissed (critical for calendar alerts)
default-timeout=0
background-color=#1e1e2e
text-color=#cdd6f4
border-color=#89b4fa
font=Geist Mono Nerd Font 12
anchor=top-right
margin=10
padding=10
border-size=2
border-radius=10
icons=true
max-icon-size=48
# Enable action buttons for Dismiss/Snooze
actions=true

[urgency=low]
default-timeout=5000

[urgency=normal]
default-timeout=10000

[urgency=critical]
default-timeout=0
